---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CursorDrawing from '../components/CursorDrawing.astro';
interface Props {
  title: string;
  description?: string;
  activeTitle?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = 'Pucz Dani’s Little Corner of the Internet',
  activeTitle,
  noindex = false,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  structuredData,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://pucz.hu');
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const defaultOgImage = '/images/pucz-hu-og.jpg';
const chosenOgImage = ogImage?.trim() || defaultOgImage;
const ogImageUrl = new URL(chosenOgImage, siteOrigin).href;
const imageAlt = ogImageAlt?.trim() || 'Pucz Dani’s Little Corner of the Internet, with two overlapping photographs on a pale blue background';
const jsonLd = JSON.stringify(structuredData || (
  Astro.url.pathname === '/' ? {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://pucz.hu/#website',
    name: 'Pucz.hu',
    alternateName: 'Dani Pucz, internet maker',
    url: 'https://pucz.hu/',
    description,
    author: { '@type': 'Person', '@id': 'https://pucz.hu/#person', name: 'Dani Pucz', url: 'https://pucz.hu/' },
  } : null
)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Pucz Dani’s Little Corner of the Internet" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  {jsonLd !== "null" && <script type="application/ld+json" set:html={jsonLd} />}
  <link rel="icon" type="image/png" sizes="120x120" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Proza+Libre:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
  <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.4.0/dist/ionicons/ionicons.esm.js"></script>
  <script is:inline>
    (() => {
      // Choose once per page load. Each palette affects its own color scheme only.
      const lightColors=['#E7CDF6','#FFE6F5','#BBE6F0','#BCEACF','#FBFBBC','#FECB7F','#FBA1A0','#FFEFE0','#FCE1E4','#ECE5FF','#E5FBF0','#F4E5FF','#FFF7EF','#FFE3F9','#C7F6FD'];
      const darkColors=['#151515','#20222E','#252E20','#2E2027','#202E2E','#2E2C20'];
      document.documentElement.style.setProperty('--random-page',lightColors[Math.floor(Math.random()*lightColors.length)]);
      document.documentElement.style.setProperty('--random-dark-page',darkColors[Math.floor(Math.random()*darkColors.length)]);
    })();
  </script>
</head>
<body>
  <CursorDrawing />
  <div class="page-shell">
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter activeTitle={activeTitle} />
  </div>
</body>
</html>
