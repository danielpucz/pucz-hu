---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CursorDrawing from '../components/CursorDrawing.astro';
interface Props { title:string; description?:string; activeTitle?:string; noindex?:boolean }
const {title,description='Pucz Dani’s Little Corner of the Internet',activeTitle,noindex=false}=Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Proza+Libre:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
  <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.4.0/dist/ionicons/ionicons.esm.js"></script>
  <script is:inline>
    (() => {const colors=['#E7CDF6','#FFE6F5','#BBE6F0','#BCEACF','#FBFBBC','#FECB7F','#FBA1A0','#FFEFE0','#FCE1E4','#ECE5FF','#E5FBF0','#F4E5FF','#FFF7EF','#FFE3F9','#C7F6FD'];document.documentElement.style.setProperty('--random-page',colors[Math.floor(Math.random()*colors.length)]);})();
  </script>
</head>
<body>
  <CursorDrawing />
  <div class="page-shell">
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter activeTitle={activeTitle} />
  </div>
</body>
</html>
