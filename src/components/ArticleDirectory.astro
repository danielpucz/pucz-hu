---
import { getCollection } from 'astro:content';
import { writingGroups, knownPostRoutes } from '../data/writing';
interface Props { activeTitle?: string }
const { activeTitle } = Astro.props;
type DirectoryPost = { title: string; href?: string; actualTitle?: string };
type CmsPost = { title: string; actualTitle: string; category: string; href: string };
const [articles, recipes] = await Promise.all([
  getCollection('articles', ({ data }) => data.published),
  getCollection('recipes', ({ data }) => data.published),
]);
const cmsPosts: CmsPost[] = [
  ...articles.map(({ id, data }) => ({
    title: data.navigationTitle || data.title,
    actualTitle: data.title,
    category: data.category,
    href: `/${data.primaryPath === 'blog' ? 'blog' : 'articles'}/${encodeURIComponent(id)}/`,
  })),
  ...recipes.map(({ id, data }) => ({
    title: data.navigationTitle || data.title,
    actualTitle: data.title,
    category: data.category,
    href: `/${data.primaryPath === 'meals' ? 'meals' : 'recipes'}/${encodeURIComponent(id)}/`,
  })),
];
const cmsRouteByCategoryAndTitle = new Map(
  cmsPosts.map((post) => [`${post.category}\u0000${post.title}`, post] as const),
);
const directoryGroups: { heading: string; posts: DirectoryPost[] }[] = writingGroups.map((group) => {
  const originalTitles = new Set(group.posts);
  const posts: DirectoryPost[] = group.posts.map((title) => {
    const cms = cmsRouteByCategoryAndTitle.get(`${group.heading}\u0000${title}`);
    return { title, href: cms?.href ?? knownPostRoutes[title], actualTitle: cms?.actualTitle };
  });
  const newPosts = cmsPosts
    .filter(({ category, title }) => category === group.heading && !originalTitles.has(title))
    .sort((a, b) => a.title.localeCompare(b.title))
    .map(({ title, actualTitle, href }) => ({ title, href, actualTitle }));
  return { heading: group.heading, posts: [...posts, ...newPosts] };
});
const originalCategories = new Set(writingGroups.map(({ heading }) => heading));
const extraCategories = [...new Set(cmsPosts.map(({ category }) => category))]
  .filter((category) => !originalCategories.has(category))
  .sort((a, b) => a.localeCompare(b));
for (const heading of extraCategories) {
  directoryGroups.push({
    heading,
    posts: cmsPosts
      .filter(({ category }) => category === heading)
      .sort((a, b) => a.title.localeCompare(b.title))
      .map(({ title, actualTitle, href }) => ({ title, href, actualTitle })),
  });
}
---
<nav class="writing-directory" aria-label="All writings">
  {directoryGroups.map((group) =>
    <span class="directory-group">
      <span class="group-name">-:~ {group.heading} ~:-</span>
      {group.posts.map(({ title, href, actualTitle }) =>
        href
          ? <a href={href} class:list={['post-chip', { active: title === activeTitle || actualTitle === activeTitle }]} aria-current={title === activeTitle || actualTitle === activeTitle ? 'page' : undefined}>{title}</a>
          : <span class="post-chip inactive">{title}</span>
      )}
    </span>
  )}
</nav>
