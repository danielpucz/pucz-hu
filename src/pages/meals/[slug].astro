---
import { getCollection, render } from 'astro:content';
import RecipeLayout from '../../layouts/RecipeLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('recipes', ({ data }) => data.published && data.primaryPath === 'meals');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedAt = entry.data.publishedAt instanceof Date
  ? entry.data.publishedAt.toISOString().slice(0, 10)
  : entry.data.publishedAt || undefined;
---
<RecipeLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  publishedAt={publishedAt}
>
  <div class="cms-content"><Content /></div>
</RecipeLayout>
