---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import * as archive from '../../data/project-archive.md';

// The archive shows the historical records regardless of the "published" flag.
// That legacy flag is reserved for any future individual project detail pages.
const allProjects = await getCollection('projects');
const yearOf = (value: string | undefined) => {
  const match = value?.match(/(?:19|20)\d{2}/);
  return match ? Number(match[0]) : null;
};
const projects = allProjects
  .map(entry => ({ ...entry, archiveYear: yearOf(entry.data.year) }))
  .sort((a, b) =>
    (b.archiveYear ?? -Infinity) - (a.archiveYear ?? -Infinity) ||
    a.data.sourceOrder - b.data.sourceOrder ||
    a.data.title.localeCompare(b.data.title)
  );
const years = [...new Set(projects.map(p => p.archiveYear).filter((year): year is number => year !== null))];
const grouped = years.map(year => ({ year, projects: projects.filter(p => p.archiveYear === year) }));
const undated = projects.filter(p => p.archiveYear === null);
const archiveTitle = archive.frontmatter.title || 'Every Project Ever*';
---
<BaseLayout
  title="Every Project Ever ~ Pucz.hu"
  description={archive.frontmatter.description || 'An improbably complete list of projects.'}
  activeTitle={archive.frontmatter.navigationTitle || 'Every Project Ever'}
>
  <article class="project-archive">
    <header class="project-hero">
      <div class="project-symbol" aria-hidden="true">💾</div>
      <p class="project-kicker">-:~ PROFESSIONAL THINGS ~:-</p>
      <h1>{archiveTitle}</h1>
      <div class="project-intro"><archive.Content /></div>
    </header>

    <div class="project-list-layout">
      <nav class="project-year-rail" aria-label="Jump to projects from a year">
        {years.map((year, index) => (
          <a
            href={`#year-${year}`}
            data-year={year}
            class:list={['project-year-link', { 'is-active': index === 0 }]}
            aria-current={index === 0 ? 'location' : undefined}
          >{year}</a>
        ))}
        {undated.length > 0 && <a href="#year-undated" data-year="undated" class="project-year-link">?</a>}
      </nav>

      <div class="project-list" aria-label="Projects by year">
        {grouped.map(group => (
          <section class="project-year-section" id={`year-${group.year}`} data-project-year={group.year} aria-label={`Projects from ${group.year}`}>
            {group.projects.map((project, index) => (
              <article class="project-row">
                <div class="project-year-cell">{index === 0 ? group.year : ''}</div>
                <div class="project-client">{project.data.client || '—'}</div>
                <div class="project-info">
                  {project.data.url && /^https?:\/\//.test(project.data.url)
                    ? <a class="project-name" href={project.data.url} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
                    : <h2 class="project-name">{project.data.title}</h2>}
                  {project.data.summary && <p class="project-summary">{project.data.summary}</p>}
                  {project.data.type && <p class="project-engagement">({project.data.type})</p>}
                  {project.data.images && project.data.images.length > 0 && (
                    <div class="project-photo-stage" aria-label={`Images of ${project.data.title}`}>
                      {project.data.images.slice(0, 3).map((photo, imageIndex) => (
                        <div
                          class="project-photo"
                          role="button"
                          tabindex="0"
                          aria-label={`${photo.alt || project.data.title} — drag to move, double-click or double-tap to enlarge, arrow keys to reposition`}
                          style={`--photo-index:${imageIndex};--angle:${[-9, -3, 9][imageIndex]}deg;--start-x:${[8, 33, 59][imageIndex]}%;--start-y:${[12, 20, 10][imageIndex]}px`}
                        >
                          <img src={photo.src} alt="" loading="lazy" draggable="false" />
                        </div>
                      ))}
                    </div>
                  )}
                </div>
                <div class="project-work">{project.data.work}</div>
              </article>
            ))}
          </section>
        ))}
        {undated.length > 0 && (
          <section class="project-year-section" id="year-undated" data-project-year="undated" aria-label="Projects without a year">
            {undated.map(project => (
              <article class="project-row">
                <div class="project-year-cell"></div>
                <div class="project-client">{project.data.client || '—'}</div>
                <div class="project-info">
                  <h2 class="project-name">{project.data.title}</h2>
                  {project.data.summary && <p class="project-summary">{project.data.summary}</p>}
                  {project.data.type && <p class="project-engagement">({project.data.type})</p>}
                  {project.data.images?.length > 0 && (
                    <div class="project-photo-stage" aria-label={`Images of ${project.data.title}`}>
                      {project.data.images.slice(0, 3).map((photo, imageIndex) => (
                        <div class="project-photo" role="button" tabindex="0" aria-label={`${photo.alt || project.data.title} — drag to move, double-click or double-tap to enlarge`} style={`--photo-index:${imageIndex};--angle:${[-9,-3,9][imageIndex]}deg;--start-x:${[8,33,59][imageIndex]}%;--start-y:${[12,20,10][imageIndex]}px`}>
                          <img src={photo.src} alt="" loading="lazy" draggable="false" />
                        </div>
                      ))}
                    </div>
                  )}
                </div>
                <div class="project-work">{project.data.work}</div>
              </article>
            ))}
          </section>
        )}
      </div>
    </div>

    <a href="/" class="back-home project-back">
      <ion-icon name="home" aria-hidden="true"></ion-icon>
      <span>Back to Homepage</span>
    </a>
  </article>
  <script is:inline src="/project-archive.js"></script>
</BaseLayout>

<style>
  .project-archive{width:min(100%,1040px);margin:0 auto}
  .project-hero{text-align:center;padding:75px 0 0}
  .project-symbol{font-size:49px;line-height:1.1;margin:0 auto 38px}
  .project-kicker{font:700 12px/1.45 var(--font-body);margin:0 0 24px}
  .project-hero h1{font:700 clamp(43px,5.6vw,70px)/1.06 var(--font-display);letter-spacing:-.035em;margin:0 0 34px}
  .project-intro{width:min(100%,690px);margin:0 auto 86px;font:400 15px/1.55 var(--font-body)}
  .project-intro :global(p){margin:0 auto 17px}
  .project-intro :global(p:first-child){font-size:20px;line-height:1.5;font-weight:500;max-width:670px}
  .project-intro :global(p:last-child){font-size:14px;margin-top:17px}
  .project-list-layout{display:grid;grid-template-columns:54px minmax(0,1fr);gap:24px;align-items:start}
  .project-year-rail{position:sticky;top:12px;align-self:start;display:flex;flex-direction:column;align-items:stretch;z-index:30;max-height:calc(100dvh - 24px);overflow-y:auto;scrollbar-width:none;overscroll-behavior:contain;touch-action:none}
  .project-year-rail::-webkit-scrollbar{display:none}
  .project-year-link{display:block;text-decoration:none;text-align:center;font:700 11px/1.12 var(--font-body);padding:5px 3px;color:var(--body-text);opacity:.78;user-select:none;-webkit-user-select:none}
  .project-year-link:hover,.project-year-link:focus-visible{opacity:1}
  .project-year-link.is-active{background:var(--body-text);color:var(--page);opacity:1}
  .project-list{min-width:0}
  .project-year-section{scroll-margin-top:18px}
  .project-row{display:grid;grid-template-columns:53px minmax(78px,120px) minmax(0,1fr) minmax(90px,125px);gap:12px;align-items:start;padding:16px 0 18px;border-bottom:1px solid color-mix(in srgb,var(--body-text) 13%,transparent);font-size:14px;line-height:1.55}
  .project-row:first-child{padding-top:0}
  .project-year-cell,.project-client{font-size:13px}
  .project-info{min-width:0}
  .project-name{font:700 15px/1.35 var(--font-body);margin:0;text-decoration:none;overflow-wrap:anywhere}
  a.project-name:hover{text-decoration:underline wavy;text-underline-offset:3px}
  .project-summary{margin:2px 0 0}
  .project-engagement{margin:17px 0 0}
  .project-work{text-align:right;font-size:12px;font-weight:700;opacity:.52}
  .project-photo-stage{height:205px;position:relative;margin:28px 0 9px;isolation:isolate}
  .project-photo{position:absolute;left:var(--start-x);top:var(--start-y);width:30%;min-width:90px;max-width:190px;padding:4px;background:white;box-shadow:0 5px 13px var(--shadow);transform:translate(var(--move-x,0px),var(--move-y,0px)) rotate(var(--angle));cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;z-index:calc(var(--photo-index) + 1)}
  .project-photo img{width:100%;height:auto;display:block;pointer-events:none;-webkit-user-drag:none}
  .project-photo.is-dragging{cursor:grabbing;z-index:20!important;box-shadow:0 12px 26px var(--shadow)}
  .project-photo.is-peeking{visibility:hidden}
  .project-photo-peek{position:fixed;z-index:10000;pointer-events:none;transition:transform .42s cubic-bezier(.2,.72,.22,1);will-change:transform;box-shadow:0 16px 44px var(--shadow)}
  .project-back{margin:75px 0 115px}
  @media(max-width:700px){
    .project-hero{padding-top:48px;text-align:left}
    .project-symbol{font-size:34px;margin:0 0 34px}
    .project-kicker{font-size:10px;margin-bottom:15px}
    .project-hero h1{font-size:clamp(40px,10.5vw,48px);max-width:240px;margin-bottom:22px}
    .project-intro{margin:0 0 58px}
    .project-intro :global(p:first-child){font-size:19px;line-height:1.58}
    .project-intro :global(p){font-size:13px;text-align:left;margin-bottom:15px}
    .project-list-layout{grid-template-columns:12px minmax(0,1fr);gap:14px}
    .project-year-rail{top:10px}
    .project-year-link{font-size:7px;padding:3px 0;font-weight:700;line-height:1.1}
    .project-row{grid-template-columns:1fr 2fr;column-gap:8px;row-gap:4px;padding:15px 0 18px;font-size:12px}
    .project-year-cell{font-size:10px;grid-column:1}
    .project-client{font-size:11px;grid-column:2}
    .project-info{grid-column:2;min-width:0}
    .project-name{font-size:13px}
    .project-summary{margin:9px 0 0}
    .project-engagement{margin-top:17px}
    .project-work{grid-column:2;text-align:left;font-size:11px;margin-top:0}
    .project-photo-stage{height:120px;margin:18px 0 8px;max-width:100%}
    .project-photo{min-width:55px;width:40%;padding:3px}
    .project-back{margin:90px 0 100px}
  }
  @media(prefers-reduced-motion:reduce){.project-photo-peek{transition:none}}
</style>
