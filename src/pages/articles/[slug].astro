---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => data.published && data.primaryPath !== 'blog');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedAt = entry.data.publishedAt instanceof Date
  ? entry.data.publishedAt.toISOString().slice(0, 10)
  : entry.data.publishedAt || undefined;
---
<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  publishedAt={publishedAt}
>
  <div class="cms-content"><Content /></div>
</ArticleLayout>
