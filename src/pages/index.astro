---
import BaseLayout from '../layouts/BaseLayout.astro';
import intro from '../data/intro.json';
import gallery from '../data/homepage-gallery.json';
---
<BaseLayout title="Pucz Dani’s Little Corner of the Internet" description="Things for the internet, people, family and a rather busy brain. Welcome to my little corner of the internet.">
  <section class="hero" aria-label="A little about me">
    <h1 class="intro" id="intro" data-stories={JSON.stringify(intro.stories)} data-ending={intro.ending}></h1>
    <p class="hint" id="intro-hint">↗ Try clicking the wavy bits.</p>
  </section>
  <section class="collage" id="homepage-collage" aria-label="A movable photo collection" data-photo-pool={JSON.stringify(gallery.images)}>
    <div class="polaroid draggable-photo photo-tree" style="--rot:-7deg"><img draggable="false" src="/images/homepage/photo-001.jpg" alt="A smiling outdoor selfie with friends near a small cottage" loading="lazy" /></div>
    <div class="polaroid draggable-photo photo-couple" style="--rot:7deg"><img draggable="false" src="/images/homepage/photo-002.jpg" alt="A person standing against a green building in an urban setting" loading="lazy" /></div>
    <div class="polaroid draggable-photo photo-hippo" style="--rot:-4deg"><img draggable="false" src="/images/homepage/photo-003.jpg" alt="A warmly lit portrait outdoors" loading="lazy" /></div>
    <div class="polaroid draggable-photo photo-walking" style="--rot:-6deg"><img draggable="false" src="/images/homepage/photo-004.jpg" alt="Two hands holding drinks together" loading="lazy" /></div>
    <div class="polaroid draggable-photo photo-friends" style="--rot:6deg"><img draggable="false" src="/images/homepage/photo-005.jpg" alt="An adult and child smiling together outdoors" loading="lazy" /></div>
  </section>
  <script is:inline src="/homepage.js"></script>
  <script is:inline src="/homepage-gallery.js"></script>
</BaseLayout>
